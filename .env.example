# =============================================================================
# CakeCraft Studio — Environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
# NEXT_PUBLIC_* vars are exposed to the browser; everything else is server-only.
# =============================================================================

# ----- App / multi-tenancy ---------------------------------------------------
# Root marketing domain + the domain tenant subdomains hang off of.
# Local dev tip: use *.localhost (e.g. acme.localhost:3000) or *.lvh.me.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ----- Supabase (Phase 2: DB, Auth, Storage, RLS) ----------------------------
# From Supabase project settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: SERVER ONLY. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (bakery subscriptions + end-customer card payments) ------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Verifies incoming Stripe webhooks (subscription + payment events).
STRIPE_WEBHOOK_SECRET=

# ----- AI (Cake design assistance + image generation) ------------------------
# Claude API key for copy/design assistance.
ANTHROPIC_API_KEY=
# Image-generation API key for cake previews (provider TBD per technical plan).
IMAGE_GENERATION_API_KEY=
