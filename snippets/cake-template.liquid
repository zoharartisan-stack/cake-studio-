{%- comment -%}
  Renders a decorative SVG cake for a given template id (1-8).
  Params: id (number)
{%- endcomment -%}
{%- assign tid = id | default: 1 -%}
<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
