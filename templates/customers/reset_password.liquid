<section class="section-spacing">
  <div class="page-width page-width--narrow">
    <div class="section-head"><h1>Reset password</h1></div>
    <div class="card">
      {%- form 'reset_customer_password' -%}
        {{ form.errors | default_errors }}
        <div class="field"><label class="field__label" for="np">New password</label><input class="input" type="password" id="np" name="customer[password]"></div>
        <div class="field"><label class="field__label" for="npc">Confirm password</label><input class="input" type="password" id="npc" name="customer[password_confirmation]"></div>
        <button type="submit" class="btn btn--block" style="margin-top:16px;">Reset</button>
      {%- endform -%}
    </div>
  </div>
</section>
