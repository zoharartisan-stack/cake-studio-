{%- liquid
  assign email = section.settings.contact_email | default: settings.contact_email
  assign phone = section.settings.contact_phone | default: settings.contact_phone
-%}
<section class="section-spacing">
  <div class="page-width page-width--narrow">
    <div class="section-head reveal">
      <span class="section-head__eyebrow">Help &amp; support</span>
      <h2>{{ section.settings.heading | default: 'We’re here to help' }}</h2>
      <p>{{ section.settings.subtitle | default: 'Questions about your order or a custom design? Reach out anytime.' }}</p>
    </div>

    <div class="features" style="grid-template-columns:1fr;gap:16px;max-width:520px;margin:0 auto;">
      <a class="card reveal" href="mailto:{{ email }}" style="display:flex;align-items:center;gap:16px;text-align:left;">
        <span class="feature__icon" style="margin:0;flex:0 0 auto;">{% render 'icon', name: 'mail' %}</span>
        <span><strong style="display:block;color:var(--color-heading);">Email us</strong><span style="color:var(--color-primary);font-weight:600;">{{ email }}</span></span>
      </a>
      <a class="card reveal" href="tel:{{ phone | replace: ' ', '' }}" style="display:flex;align-items:center;gap:16px;text-align:left;">
        <span class="feature__icon" style="margin:0;flex:0 0 auto;">{% render 'icon', name: 'phone' %}</span>
        <span><strong style="display:block;color:var(--color-heading);">Call or WhatsApp</strong><span style="color:var(--color-primary);font-weight:600;">{{ phone }}</span></span>
      </a>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div style="margin-top:40px;">
        <h3 style="text-align:center;margin-bottom:20px;">Frequently asked questions</h3>
        {%- for block in section.blocks -%}
          <details class="card reveal" style="margin-bottom:12px;" {{ block.shopify_attributes }}>
            <summary style="cursor:pointer;font-weight:600;color:var(--color-heading);list-style:none;">{{ block.settings.question }}</summary>
            <p style="margin-top:10px;opacity:.85;">{{ block.settings.answer }}</p>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Help",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "contact_email", "label": "Email" },
    { "type": "text", "id": "contact_phone", "label": "Phone" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "We recommend ordering at least 48 hours in advance for custom cakes." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Help",
      "blocks": [
        { "type": "faq", "settings": { "question": "How far in advance should I order?", "answer": "Please order at least 48 hours ahead so we can craft your cake perfectly. For elaborate custom designs, 3–4 days is ideal." } },
        { "type": "faq", "settings": { "question": "Can I upload my own design?", "answer": "Yes! In the ‘Make Your Own Cake’ builder, step 5 lets you upload an inspiration image." } },
        { "type": "faq", "settings": { "question": "Which areas do you deliver to?", "answer": "Contact us with your city and address and we’ll confirm delivery availability and timing." } }
      ]
    }
  ]
}
{% endschema %}
