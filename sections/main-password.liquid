<div class="page-width">
  <div style="font-size:4rem;">🎂</div>
  <h1 style="font-family:'Dancing Script',cursive;color:var(--color-primary);font-size:3rem;">Cake Craft</h1>
  <p style="margin:12px 0 24px;opacity:.85;">{{ shop.password_message | default: 'Opening soon. Something sweet is on the way.' }}</p>
  <div class="card" style="max-width:420px;margin:0 auto;">
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p style="color:var(--color-primary);margin-bottom:10px;">{{ form.errors.messages.first }}</p>{%- endif -%}
      <div style="display:flex;gap:10px;">
        <input type="password" name="password" class="input" placeholder="Enter password">
        <button type="submit" class="btn">Enter</button>
      </div>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
