<section class="section-spacing">
  <div class="page-width">
    <div class="section-head"><h1>{{ collection.title }}</h1>{% if collection.description != blank %}<p>{{ collection.description }}</p>{% endif %}</div>
    <div class="designs-grid">
      {%- for product in collection.products -%}
        <a class="design-card" href="{{ product.url }}">
          <div class="design-card__media">
            {%- if product.featured_image -%}
              <img class="design-card__img" src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" width="500" height="375" loading="lazy">
            {%- else -%}
              <div style="display:flex;align-items:center;justify-content:center;font-size:3rem;">🎂</div>
            {%- endif -%}
          </div>
          <div class="design-card__body">
            <h3 class="design-card__title">{{ product.title }}</h3>
            <span class="design-card__price">{{ product.price | money }}</span>
          </div>
        </a>
      {%- else -%}
        <p>No products found.</p>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
