{%- capture make_url %}{% render 'nav-url', handle: 'make-your-own-cake', anchor: 'builder' %}{% endcapture -%}
<section class="section-spacing">
  <div class="page-width">
    <div class="card reveal" style="background: linear-gradient(135deg, var(--color-primary), #d0567a); color:#fff; text-align:center; padding: clamp(36px,6vw,64px);">
      <h2 style="color:#fff; font-size: clamp(1.7rem,4vw,2.6rem); margin-bottom:12px;">{{ section.settings.heading | default: 'Ready to create something sweet?' }}</h2>
      <p style="opacity:.92; max-width:560px; margin:0 auto 26px; font-size:clamp(1rem,2vw,1.15rem);">{{ section.settings.subtitle | default: 'Design your custom cake now with our easy step-by-step builder and live preview.' }}</p>
      <a class="btn btn--lg" style="--color-primary:#fff; --btn-color: var(--color-primary); color: var(--color-primary); background:#fff;" href="{{ make_url }}">{{ section.settings.button_label | default: 'Customize My Cake' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" },
    { "type": "text", "id": "button_label", "label": "Button label" }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
