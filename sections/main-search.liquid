<section class="section-spacing">
  <div class="page-width page-width--narrow">
    <div class="section-head"><h1>{{ 'general.search.title' | t }}</h1></div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="card">
      <div style="display:flex;gap:12px;">
        <input type="search" name="q" value="{{ search.terms | escape }}" class="input" placeholder="{{ 'general.search.placeholder' | t }}">
        <button type="submit" class="btn">{{ 'general.search.submit' | t }}</button>
      </div>
    </form>
    {%- if search.performed -%}
      <div class="designs-grid" style="margin-top:24px;">
        {%- for item in search.results -%}
          <a class="design-card" href="{{ item.url }}">
            <div class="design-card__body">
              <h3 class="design-card__title">{{ item.title }}</h3>
              {%- if item.price -%}<span class="design-card__price">{{ item.price | money }}</span>{%- endif -%}
            </div>
          </a>
        {%- else -%}
          <p>{{ 'general.search.no_results' | t }}</p>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
