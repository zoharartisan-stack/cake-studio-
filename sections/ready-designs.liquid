{%- capture make_url %}{% render 'nav-url', handle: 'make-your-own-cake', anchor: 'builder' %}{% endcapture -%}
<section class="section-spacing" id="ready-designs">
  <div class="page-width">
    <div class="section-head reveal">
      <span class="section-head__eyebrow">{{ section.settings.eyebrow | default: 'Ready designs' }}</span>
      <h2>{{ section.settings.heading | default: 'Our signature cake collection' }}</h2>
      <p>{{ section.settings.subtitle | default: 'Pick a favorite and customize it your way — size, flavor, message and more.' }}</p>
    </div>
    <div class="designs-grid">
      {%- assign names = 'Cherry Blossom,Lavender Dream,Ocean Breeze,Golden Honey,Sweetheart,Fresh Mint,Elegant Noir,Berry Bliss' | split: ',' -%}
      {%- assign descs = 'Soft pink with cherries,Purple floral elegance,Cool blue celebration,Warm caramel gold,Romantic heart cake,Minty green delight,Sophisticated black,Deep berry layers' | split: ',' -%}
      {%- assign prices = '3500,3200,3000,3300,2800,3100,4200,3600' | split: ',' -%}
      {%- for i in (1..8) -%}
        {%- assign idx = forloop.index0 -%}
        <article class="design-card reveal">
          <div class="design-card__media">
            {% render 'cake-template', id: forloop.index %}
            <span class="design-card__badge">Template</span>
          </div>
          <div class="design-card__body">
            <h3 class="design-card__title">{{ names[idx] }}</h3>
            <p style="font-size:.9rem;opacity:.75;">{{ descs[idx] }}</p>
            <span class="design-card__price">From Rs {{ prices[idx] }}</span>
            <a class="btn btn--block" href="{{ make_url }}?template={{ forloop.index }}">Customize this cake</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ready designs",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" }
  ],
  "presets": [{ "name": "Ready designs" }]
}
{% endschema %}
